   "description": "Roe deer habitat score v1.1: weights fitted to GBIF sightings with observer-bias correction, tested with spatial cross-validation.",
   "rationale": "Weights fitted to 186 roe deer sightings against 1898 sightings of other mammals made by the same kind of observers, with guardrails: woodland nearby, the field–forest mosaic and green food always count, and no indicator takes more than 30%. The data say roe deer here are found on open feeding land in a field–forest mosaic, away from towns and roads.",
   "heldout": "Spatial cross-validation (9 km blocks held out): AUC 0.74 against where people report other mammals, 0.54 against the whole region. The first expert guess scored 0.51 and 0.41."
  },
  "wild_boar": {
   "label": "Wild boar",
   "species": "wild_boar",
   "mode": "habitat",
   "status": "Literature weights, not yet testable",
   "weights": {
    "woodland": 20,
    "cover": 15,
    "crops": 25,
    "water": 15,
    "towns_far": 15,
    "moisture": 10
   },
   "rationale": "Wild boar rest in dense cover and feed in fields at night, so woodland, dense cover and nearby farmland lead; wet ground for wallowing and distance from villages follow. Only 7 usable GBIF records exist in the region, so these literature weights cannot be tested yet.",
   "description": "Wild boar habitat score v1.1 (literature weights; 7 sightings, too few to test).",
   "noValidation": "Only 7 usable wild boar records in GBIF here: too few to test. Hunting-bag records per hunting ground would fix this."
  },
  "biodiversity": {
   "label": "Biodiversity potential",
   "species": null,
   "mode": "biodiversity",
   "status": "Literature weights, not yet testable",
   "weights": {
