   "description": "Roe deer habitat score v1.1: weights fitted to GBIF sightings with observer-bias correction, tested with spatial cross-validation.",
   "rationale": "Weights fitted to 155 roe deer sightings since 2017 against 1724 sightings of other mammals made by the same kind of observers, with guardrails: woodland nearby, the field–forest mosaic and green food always count, and no indicator takes more than 30%. Open land, farmland and the mosaic are measured inside each square, so the map shows differences from one square to the next.",
   "heldout": "Spatial cross-validation (9 km blocks held out): AUC 0.73 against where people report other mammals, 0.53 against the whole region. The first expert guess scored 0.51."
  },
  "wild_boar": {
   "label": "Wild boar",
   "species": "wild_boar",
   "mode": "habitat",
   "status": "Literature weights, not yet testable",
   "weights": {
    "woodland": 20,
    "cover": 15,
    "crops": 25,
    "water": 15,
    "towns_far": 15,
    "moisture": 10
   },
   "rationale": "Wild boar rest in dense cover and feed in fields at night, so woodland, dense cover and nearby farmland lead; wet ground for wallowing and distance from villages follow. Only 7 usable GBIF records exist in the region, so these literature weights cannot be tested yet.",
   "description": "Wild boar habitat score v1.1 (literature weights; 7 sightings, too few to test).",
   "noValidation": "Only 7 usable wild boar records in GBIF here: too few to test. Hunting-bag records per hunting ground would fix this."
  },
  "biodiversity": {
   "label": "Biodiversity potential",
   "species": null,
   "mode": "biodiversity",
   "status": "Nature only · untested",
   "weights": {
    "distinct": 25,
    "diversity": 25,
    "natural": 20,
    "spectral": 15,
    "water": 10,
    "woodland": 5
   },
   "rationale": "Nature only: how valuable the habitat types are (distinctiveness, as in the biodiversity net gain metric), how many types are mixed, how much is semi-natural, how varied the vegetation is, plus water and woodland. Distance from towns and roads is left out by default so the map shows the land itself; tick them under \"More indicators\" to add disturbance. A proxy for how much life a place can support, not a species count.",
   "description": "Biodiversity potential from nature indicators only: habitat distinctiveness, variety, natural cover, plant variety, water and woodland.",
   "noValidation": "Not yet tested in the pilot region. Analysed areas are checked live against the variety of species recorded there (GBIF). A proper test needs surveys with known effort."
  }
